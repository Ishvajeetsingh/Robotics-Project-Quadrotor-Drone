#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/BrushedAluminium.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/dji/mavic/protos/Mavic2Pro.proto"

# =============================================================================
# Webots World File - Mavic 2 Pro Survey Mission
# Compatible with Webots R2025a
# =============================================================================
# Scene:  flat terrain, 6 survey waypoints in a rectangular pattern
# Drone:  DJI Mavic 2 Pro at the world origin
# Controller: mavic2pro_controller (auto-launched by Webots)
# =============================================================================

WorldInfo {
  info [
    "AISR Quadrotor Drone - Altitude and Waypoint Control"
    "Webots R2025a"
    "Controller: mavic2pro_controller"
  ]
  title "Mavic 2 Pro Survey Mission"
  basicTimeStep 32
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}

Viewpoint {
  orientation 0.28 0.28 -0.92 1.9
  position 10 -10 12
  near 0.2
  follow "Mavic 2 Pro"
  followSmoothness 0.2
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  floorSize 40 40
  floorAppearance SandyGround {
  }
  wallThickness 0.1
  wallHeight 0.5
  wallAppearance BrushedAluminium {
  }
}

# =============================================================================
# Survey waypoint markers (cylinders standing upright on the arena floor)
# =============================================================================

# Waypoint A  (5, 0)
Solid {
  translation 5 0 0.05
  rotation 1 0 0 1.57079632679
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 1 0
        }
      }
      geometry Cylinder {
        height 0.1
        radius 0.25
      }
    }
  ]
  name "WP_A"
}

# Waypoint B  (5, -5)
Solid {
  translation 5 -5 0.05
  rotation 1 0 0 1.57079632679
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 0.5 0
        }
      }
      geometry Cylinder {
        height 0.1
        radius 0.25
      }
    }
  ]
  name "WP_B"
}

# Waypoint C  (0, -5)
Solid {
  translation 0 -5 0.05
  rotation 1 0 0 1.57079632679
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 1 0.5
        }
      }
      geometry Cylinder {
        height 0.1
        radius 0.25
      }
    }
  ]
  name "WP_C"
}

# Waypoint D  (-5, -5)
Solid {
  translation -5 -5 0.05
  rotation 1 0 0 1.57079632679
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 0.5 1
        }
      }
      geometry Cylinder {
        height 0.1
        radius 0.25
      }
    }
  ]
  name "WP_D"
}

# Waypoint E  (-5, 0)
Solid {
  translation -5 0 0.05
  rotation 1 0 0 1.57079632679
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.6 0 1
        }
      }
      geometry Cylinder {
        height 0.1
        radius 0.25
      }
    }
  ]
  name "WP_E"
}

# =============================================================================
# DJI Mavic 2 Pro drone
# =============================================================================

Mavic2Pro {
  translation 0 0 0.1
  rotation 0 0 1 0
  name "Mavic 2 Pro"
  controller "mavic2pro_controller"
  controllerArgs "--experiment tuned"
  customData ""
  supervisor FALSE
  synchronization TRUE
  cameraSlot [
    Camera {
      width 400
      height 240
      near 0.2
      far 100
    }
  ]
}

